//for Ubuntu

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run C++",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "g++ -std=c++17 ${file} -o ${fileBasenameNoExtension} && ./${fileBasenameNoExtension} < input.txt > output.txt"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}